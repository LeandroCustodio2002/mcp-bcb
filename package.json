{
  "name": "mcp-bcb-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "dev:worker": "pnpm --filter @mcp-bcb/worker dev",
    "deploy:worker": "pnpm --filter @mcp-bcb/worker run deploy",
    "inspector": "pnpm --filter mcp-bcb build && npx @modelcontextprotocol/inspector node packages/cli/dist/index.js",
    "smoke": "pnpm --filter mcp-bcb build && node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
